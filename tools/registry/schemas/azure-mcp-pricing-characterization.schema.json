{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apexops.dev/azure-mcp-pricing-characterization-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "observedAt", "distribution", "startup", "inventory", "disposition"],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "tarballSource", "tarballSha256", "bytes"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "version": { "const": "2.0.5" },
        "tarballSource": { "type": "string", "format": "uri", "pattern": "^https://" },
        "tarballSha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "producer"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)tools/registry/evidence/[A-Za-z0-9._/-]+\\.json$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "producer": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  },
  "properties": {
    "$schema": { "const": "schemas/azure-mcp-pricing-characterization.schema.json" },
    "schemaVersion": { "const": "1.0.0" },
    "observedAt": { "type": "string", "format": "date" },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wrapper", "platform", "reportedBuild"],
      "properties": {
        "wrapper": { "$ref": "#/$defs/artifact" },
        "platform": { "$ref": "#/$defs/artifact" },
        "reportedBuild": { "const": "2.0.5+2712e19ddf1c55f8e73ead8fb671915ec92801cc" }
      }
    },
    "startup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "readOnly", "selectedTools", "dangerousOptionsEnabled"],
      "properties": {
        "transport": { "const": "stdio" },
        "readOnly": { "const": true },
        "selectedTools": { "const": ["pricing_get"] },
        "dangerousOptionsEnabled": { "const": false }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "pricingTools",
        "unrestrictedToolCount",
        "readOnlyToolCount",
        "excludedByReadOnlyCount",
        "costManagementTools",
        "billingTools",
        "budgetTools",
        "pricingOutputSchemaPresent"
      ],
      "properties": {
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pricingToolsList", "unrestrictedToolNames", "readOnlyToolNames"],
          "properties": {
            "pricingToolsList": { "$ref": "#/$defs/evidence" },
            "unrestrictedToolNames": { "$ref": "#/$defs/evidence" },
            "readOnlyToolNames": { "$ref": "#/$defs/evidence" }
          }
        },
        "pricingTools": { "const": ["pricing_get"] },
        "unrestrictedToolCount": { "const": 315 },
        "readOnlyToolCount": { "const": 175 },
        "excludedByReadOnlyCount": { "const": 140 },
        "costManagementTools": { "const": [] },
        "billingTools": { "const": [] },
        "budgetTools": { "const": [] },
        "pricingOutputSchemaPresent": { "const": false }
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "adapterReady", "managedAuthority", "blockers"],
      "properties": {
        "mode": { "const": "characterization-only" },
        "adapterReady": { "const": false },
        "managedAuthority": { "const": false },
        "blockers": {
          "const": ["NO_FIXED_HOST", "NO_OUTPUT_SCHEMA", "NO_COST_MANAGEMENT_TOOLS", "PRERELEASE_NEWER_THAN_STABLE"]
        }
      }
    }
  }
}
