{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apexops.dev/guidance-delivery-v1.json",
  "title": "Current APEX managed guidance delivery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "baselineCommit",
    "scope",
    "skills",
    "instructions",
    "maintainerSkills",
    "deferredCapabilities",
    "provenanceOwner",
    "qualification"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "baselineCommit": { "$ref": "#/$defs/gitSha" },
    "scope": { "$ref": "#/$defs/text" },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "entrypoint", "files", "manifestOwner", "status", "capabilityQualification"],
        "properties": {
          "id": { "type": "string", "pattern": "^apex-[a-z0-9-]+$" },
          "owner": { "$ref": "#/$defs/text" },
          "entrypoint": { "type": "string", "pattern": "^\\.github/skills/apex-[a-z0-9-]+/SKILL\\.md$" },
          "files": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^\\.github/skills/apex-[a-z0-9-]+/" }
          },
          "manifestOwner": { "const": "plugin" },
          "status": { "const": "current-source" },
          "capabilityQualification": { "const": "not-established-by-this-registry" }
        }
      }
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "owner", "manifestOwner"],
        "properties": {
          "path": { "type": "string", "pattern": "^\\.github/instructions/apex-[a-z0-9-]+\\.instructions\\.md$" },
          "owner": { "const": "managed workspace" },
          "manifestOwner": { "const": "workspace" }
        }
      }
    },
    "maintainerSkills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "entrypoint", "purpose"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "entrypoint": { "type": "string", "pattern": "^\\.github/skills/[a-z0-9-]+/SKILL\\.md$" },
          "purpose": { "$ref": "#/$defs/text" }
        }
      }
    },
    "deferredCapabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ownerPackage",
          "managedSkill",
          "status",
          "reason",
          "scenarioIds",
          "archiveEntry",
          "sourceSha256",
          "replacementProof",
          "rollbackGate",
          "scopeRule"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^deferred:[a-z][a-z0-9-]+(?:/[^\\\\]+)?$" },
          "ownerPackage": { "enum": ["packages/renderers", "packages/capabilities"] },
          "managedSkill": { "type": "string", "pattern": "^apex-[a-z0-9-]+$" },
          "status": { "const": "deferred" },
          "reason": { "$ref": "#/$defs/text" },
          "scenarioIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/text" }
          },
          "archiveEntry": { "type": "string", "pattern": "^\\.github/skills/[a-z0-9-]+/" },
          "sourceSha256": { "$ref": "#/$defs/sha256" },
          "replacementProof": { "$ref": "#/$defs/text" },
          "rollbackGate": { "$ref": "#/$defs/text" },
          "scopeRule": { "$ref": "#/$defs/text" }
        }
      }
    },
    "provenanceOwner": { "const": "tools/registry/skill-upstream-pins.v1.json" },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "clients", "live"],
      "properties": {
        "capability": { "const": "not-run" },
        "clients": { "const": "not-run" },
        "live": { "const": "not-run" }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
