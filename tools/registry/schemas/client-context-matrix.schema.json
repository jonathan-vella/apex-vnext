{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apexops.dev/client-context-matrix-v1.json",
  "title": "APEX client context sampling matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "evidenceKind",
    "requiredSamples",
    "optionalMetricsPolicy",
    "clients",
    "cells"
  ],
  "properties": {
    "$schema": { "const": "schemas/client-context-matrix.schema.json" },
    "schemaVersion": { "const": "1.0.0" },
    "id": { "const": "milestone-o-stratified-v1" },
    "evidenceKind": { "const": "live" },
    "requiredSamples": { "const": 12 },
    "optionalMetricsPolicy": { "const": "report-only" },
    "clients": {
      "const": [
        {
          "id": "github-copilot-vscode",
          "version": "1.130.0",
          "extensionVersion": "0.58.0"
        },
        { "id": "github-copilot-cli", "version": "1.0.73" }
      ]
    },
    "cells": {
      "const": [
        {
          "id": "simple-neutral-normal",
          "scenarioId": "requirements-simple-neutral",
          "tier": "simple",
          "iacTrack": "neutral",
          "retry": false
        },
        {
          "id": "simple-neutral-retry",
          "scenarioId": "requirements-simple-neutral",
          "tier": "simple",
          "iacTrack": "neutral",
          "retry": true
        },
        {
          "id": "standard-bicep-normal",
          "scenarioId": "architecture-standard-bicep",
          "tier": "standard",
          "iacTrack": "bicep",
          "retry": false
        },
        {
          "id": "standard-bicep-retry",
          "scenarioId": "architecture-standard-bicep",
          "tier": "standard",
          "iacTrack": "bicep",
          "retry": true
        },
        {
          "id": "standard-terraform-normal",
          "scenarioId": "architecture-standard-terraform",
          "tier": "standard",
          "iacTrack": "terraform",
          "retry": false
        },
        {
          "id": "standard-terraform-retry",
          "scenarioId": "architecture-standard-terraform",
          "tier": "standard",
          "iacTrack": "terraform",
          "retry": true
        }
      ]
    }
  }
}
