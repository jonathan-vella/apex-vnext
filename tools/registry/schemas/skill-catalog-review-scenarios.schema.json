{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apexops.dev/skill-catalog-review-scenarios-v1.json",
  "title": "APEX skill catalog review scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "qualification", "scenarios"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "1.0.0" },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "live", "clients"],
      "properties": {
        "mode": { "const": "deterministic-fixture-only" },
        "live": { "const": "not-run" },
        "clients": { "const": "not-run" }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "intent", "expected", "authority"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
          "category": {
            "enum": [
              "discovery-positive",
              "discovery-near-miss",
              "unavailable-capability",
              "direct-operation-denial",
              "requirements-native-workflow",
              "bicep-complete-reference"
            ]
          },
          "intent": { "type": "string", "minLength": 1 },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["outcome", "evidence"],
            "properties": {
              "outcome": { "type": "string", "minLength": 1 },
              "evidence": { "type": "string", "minLength": 1 },
              "skill": { "type": "string", "pattern": "^apex-[a-z0-9-]+$" }
            }
          },
          "authority": {
            "type": "object",
            "additionalProperties": false,
            "required": ["liveQualification", "clientQualification", "directOperation"],
            "properties": {
              "liveQualification": { "const": "not-run" },
              "clientQualification": { "const": "not-run" },
              "directOperation": { "enum": ["not-requested", "denied"] }
            }
          }
        }
      }
    }
  }
}
