{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apexops.dev/vscode-installation-lifecycle-v1.json",
  "title": "APEX VS Code installation lifecycle qualification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "client", "evidencePolicy", "scenarios"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "1.0.0" },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "minimumVersionSource", "observedVersionBinding"],
      "properties": {
        "id": { "const": "github-copilot-vscode" },
        "minimumVersionSource": { "const": "config/toolchain.v1.json#/core/vscode/minimumSupportedVersion" },
        "observedVersionBinding": { "const": "candidate-bound" }
      }
    },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deterministic", "live"],
      "properties": {
        "deterministic": { "const": "required" },
        "live": { "const": "required" }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose", "deterministicEvidence", "liveStatus"],
        "properties": {
          "id": { "type": "string", "pattern": "^VSCODE-LIFECYCLE-[0-9]{3}$" },
          "purpose": { "type": "string", "minLength": 1 },
          "deterministicEvidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^packages/cli/src/test/.+\\.test\\.ts$" }
          },
          "liveStatus": { "enum": ["not-run", "passed", "failed"] },
          "liveEvidenceRef": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
