{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apexops.dev/optimization-client-preflight-v1.json",
  "title": "APEX optimization client measurement preflight",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidate", "gateCandidate", "status", "clients"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "worktreeClean"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "worktreeClean": { "type": "boolean" }
      }
    },
    "gateCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "status": { "enum": ["ready", "blocked"] },
    "clients": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "enum": ["github-copilot-vscode", "github-copilot-cli"] },
          "status": {
            "enum": ["ready", "missing", "version-mismatch", "extension-unavailable", "interactive-install-required"]
          },
          "expectedVersion": { "type": "string", "minLength": 1 },
          "observedVersion": { "type": "string", "minLength": 1 },
          "minimumVersion": { "type": "string", "minLength": 1 },
          "observedExtensionVersion": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "id": { "const": "github-copilot-vscode" } }, "required": ["id"] },
            "then": {
              "properties": {
                "minimumVersion": { "type": "string", "minLength": 1 }
              },
              "required": ["minimumVersion"]
            }
          },
          {
            "if": { "properties": { "id": { "const": "github-copilot-cli" } }, "required": ["id"] },
            "then": {
              "properties": { "expectedVersion": { "type": "string", "minLength": 1 } },
              "required": ["expectedVersion"]
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "clients": {
          "type": "array",
          "contains": {
            "type": "object",
            "properties": { "id": { "const": "github-copilot-vscode" } },
            "required": ["id"]
          }
        }
      }
    },
    {
      "properties": {
        "clients": {
          "type": "array",
          "contains": {
            "type": "object",
            "properties": { "id": { "const": "github-copilot-cli" } },
            "required": ["id"]
          }
        }
      }
    }
  ]
}
