{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apexops.dev/skill-upstream-pins-v1.json",
  "title": "APEX shipped skill upstream pins",
  "description": "Records the exact upstream commit each shipped skill was last re-ported from, and how the port was adapted to the vNext kernel boundaries. One entry per shipped skill; update the entry when the skill is re-ported.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policy", "entries"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "1.0.0" },
    "policy": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skill",
          "upstreamRepository",
          "upstreamPath",
          "upstreamCommit",
          "portedOn",
          "tracking",
          "adaptations",
          "dropped"
        ],
        "properties": {
          "skill": { "type": "string", "pattern": "^apex-[a-z0-9][a-z0-9-]*$" },
          "upstreamRepository": { "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$" },
          "upstreamPath": { "type": "string", "pattern": "^\\.github/skills/[a-z0-9][a-z0-9-]*/$" },
          "upstreamCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "portedOn": { "type": "string", "format": "date" },
          "tracking": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^#[0-9]+$" }
          },
          "adaptations": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "dropped": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
