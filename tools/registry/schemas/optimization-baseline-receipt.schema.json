{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.apexops.dev/optimization-baseline-receipt-v1.json",
  "title": "APEX optimization baseline receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "observedAt", "candidate", "inventory", "surfaces", "authorization"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "observedAt": { "type": "string", "format": "date-time" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trackedPathCount", "sha256"],
      "properties": {
        "trackedPathCount": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "trackedPathCount", "byteCount"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
          "trackedPathCount": { "type": "integer", "minimum": 0 },
          "byteCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "const": "not-granted" }
      }
    }
  }
}
