{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jonathan-vella/apex-vnext/schemas/pre-agent-loop-authorization.schema.json",
  "title": "Pre-Agent Loop Run Authorization",
  "description": "Human-authored authorization for one bounded unattended repository-maintenance run. Implements DECISION-020 and issue #222. The loop reads this file and never writes it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "authorization_id",
    "authored_by",
    "authored_at",
    "expires_at",
    "base_commit",
    "issues",
    "worktree",
    "branch",
    "upstream",
    "allowed_paths",
    "protected_paths",
    "allowed_commands",
    "denied_commands",
    "network",
    "launcher",
    "budgets",
    "checkpoint_policy",
    "stop_conditions",
    "skill_allowlist",
    "context_hashes"
  ],
  "properties": {
    "version": { "const": 1 },
    "authorization_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{8,64}$",
      "description": "Stable identifier recorded in every checkpoint."
    },
    "authored_by": { "type": "string", "minLength": 1 },
    "authored_at": { "type": "string", "format": "date-time" },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Hard stop. The loop refuses to start or resume past this instant."
    },
    "base_commit": {
      "type": "string",
      "description": "Full SHA, or the literal 'origin/main' for late binding at bootstrap.",
      "anyOf": [{ "pattern": "^[0-9a-f]{40}$" }, { "const": "origin/main" }]
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 1 }
    },
    "worktree": { "type": "string", "minLength": 1 },
    "branch": {
      "type": "string",
      "pattern": "^(feat|fix|chore|refactor|revert|perf|test|build|ci)/[a-z0-9._-]+$",
      "description": "Must be a cross-cutting prefix; validate-branch-scope.sh rejects domain prefixes for this work."
    },
    "upstream": { "type": "string", "pattern": "^origin/" },
    "allowed_paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "protected_paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "allowed_commands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Command prefixes the controller may run. A prefix match is sufficient, so denied_commands must exclude any aggregate the prefix would otherwise reach."
    },
    "denied_commands": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Command prefixes that are refused even when allowed_commands matches. Deny always wins."
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": {
        "policy": { "enum": ["deny", "allowlist"] },
        "allowed_hosts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "launcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binary", "version", "model", "mcp"],
      "properties": {
        "binary": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "mcp": {
          "const": "disabled",
          "description": "Issue #222 forbids MCP servers inside launched tasks."
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files_per_slice",
        "lines_per_slice",
        "repair_attempts",
        "queue_items",
        "wall_clock_minutes",
        "credits"
      ],
      "properties": {
        "files_per_slice": { "type": "integer", "minimum": 1, "maximum": 50 },
        "lines_per_slice": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "repair_attempts": { "type": "integer", "minimum": 0, "maximum": 1 },
        "queue_items": { "type": "integer", "minimum": 1, "maximum": 100 },
        "wall_clock_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "credits": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "checkpoint_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_per_accepted_slice", "push_every_commit", "verify_remote_sha"],
      "properties": {
        "commit_per_accepted_slice": { "const": true },
        "push_every_commit": { "const": true },
        "verify_remote_sha": { "const": true }
      }
    },
    "stop_conditions": { "type": "array", "items": { "type": "string" } },
    "skill_allowlist": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Default empty. Per-item allowlists may only narrow, never widen, this set."
    },
    "context_hashes": {
      "type": "object",
      "description": "SHA-256 of each context input. Keys are repository-relative paths, or a derived key such as 'skill-metadata-inventory' whose value is computed by tools/scripts/pre-agent-loop-hashes.mjs. Bootstrap stops on any mismatch.",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "notes": { "type": "string" }
  }
}
