{
  "name": "APEX",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu26.04",

  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "installBicep": true,
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/powershell:2": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.14",
      "installTools": false
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24",
      "pnpmVersion": "none"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },
    "./features/terraform": {},
    "ghcr.io/azure/azure-dev/azd:latest": {}
  },

  // Install only repository test prerequisites before the deterministic vNext bootstrap.
  "onCreateCommand": "set -e; sudo rm -f /etc/apt/sources.list.d/yarn.list 2>/dev/null; sudo apt-get update; sudo apt-get install -y --no-install-recommends bats gitleaks; sudo rm -rf /var/lib/apt/lists/*; sudo install -d -m 0755 -o vscode -g vscode \"$HOME/.cache\" \"$HOME/.local/bin\"; curl -LsSf https://astral.sh/uv/install.sh | sh",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "npx lefthook install",

  // Environment variables for Python optimization
  "containerEnv": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONUNBUFFERED": "1",
    "UV_CACHE_DIR": "/home/vscode/.cache/uv",
    "TF_PLUGIN_CACHE_DIR": "/home/vscode/.terraform.d/plugin-cache"
  },

  "remoteEnv": {
    "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}",
    "AZURE_DEFAULTS_LOCATION": "swedencentral",
    // Pass GH_TOKEN from host → container. gh CLI uses it automatically, no `gh auth login` needed.
    // Each user sets this once in VS Code User Settings (Ctrl+,):
    //   "terminal.integrated.env.linux": { "GH_TOKEN": "ghp_yourTokenHere" }
    // This is the ONLY supported method — shell exports (.bashrc/.profile) do NOT propagate reliably.
    // Value is empty string if not set — gh CLI falls back to its normal auth flow.
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  },

  "customizations": {
    "vscode": {
      // Exact vNext editor surface: managed agents, IaC, repository validation,
      // and language support. Extension packs are prohibited because their
      // transitive Copilot contributions bypass inventory validation.
      "extensions": [
        "GitHub.copilot-chat",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-bicep",
        "ms-vscode.powershell",
        "DavidAnson.vscode-markdownlint",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "esbenp.prettier-vscode",
        "redhat.vscode-yaml",
        "HashiCorp.terraform"
      ],
      "settings": {
        "chat.useAgentsMdFile": true,
        "chat.useNestedAgentsMdFiles": true,
        "chat.useClaudeMdFile": false,
        "chat.customAgentInSubagent.enabled": true,
        "chat.agentFilesLocations": {
          "customizations/.github/agents": true,
          "~/.copilot/agents": false,
          "~/.claude/agents": false
        },
        "chat.agentSkillsLocations": {
          ".github/skills": true,
          "customizations/.github/skills": true,
          ".agents/skills": false,
          ".claude/skills": false,
          "~/.agents/skills": false,
          "~/.copilot/skills": false,
          "~/.claude/skills": false
        },
        "chat.instructionsFilesLocations": {
          ".github/instructions": true,
          "~/.copilot/instructions": false,
          "~/.claude/rules": false
        },
        "chat.hookFilesLocations": {
          ".github/hooks/tool-guardian": true
        },
        "chat.useCustomAgentHooks": true,
        "chat.useAgentSkills": true,
        "github.copilot.chat.agentDebugLog.fileLogging.enabled": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.rulers": [120],
        "editor.wordWrap": "wordWrapColumn",
        "editor.wordWrapColumn": 120,
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.eol": "\n",
        "editor.tabSize": 2,
        "[markdown]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.rulers": [120],
          "editor.wordWrap": "wordWrapColumn",
          "editor.wordWrapColumn": 120
        },
        "[bicep]": {
          "editor.tabSize": 2
        },
        "[terraform]": {
          "editor.tabSize": 2,
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "hashicorp.terraform"
        },
        "[powershell]": {
          "editor.tabSize": 4
        },
        "[python]": {
          "editor.tabSize": 4
        },
        "python.defaultInterpreterPath": "/usr/local/python/current/bin/python3",
        "python.analysis.typeCheckingMode": "basic",
        "markdownlint.config": {
          "extends": "${workspaceFolder}/.markdownlint-cli2.jsonc"
        },
        "markdownlint.run": "onSave"
      }
    }
  },

  // Named volumes work identically on Windows, macOS, Linux, amd64, and arm64.
  "mounts": [
    {
      "source": "devcontainer-azure-config-${devcontainerId}",
      "target": "/home/vscode/.azure",
      "type": "volume"
    },
    {
      "source": "devcontainer-azd-config-${devcontainerId}",
      "target": "/home/vscode/.azd",
      "type": "volume"
    },
    {
      "source": "devcontainer-gh-config-${devcontainerId}",
      "target": "/home/vscode/.config/gh",
      "type": "volume"
    },
    {
      "source": "devcontainer-uv-cache-${devcontainerId}",
      "target": "/home/vscode/.cache/uv",
      "type": "volume"
    },
    {
      "source": "devcontainer-terraform-cache-${devcontainerId}",
      "target": "/home/vscode/.terraform.d/plugin-cache",
      "type": "volume"
    }
  ],

  "remoteUser": "vscode"
}
