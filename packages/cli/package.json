{
  "name": "@apexops/cli",
  "version": "0.10.0-next.5",
  "description": "Portable no-shell CLI and MCP facade for APEX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonathan-vella/apex-vnext.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "apex": "./dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/test/**",
    "assets"
  ],
  "dependencies": {
    "@apexops/capabilities": "0.10.0-next.5",
    "@apexops/contracts": "0.10.0-next.5",
    "@apexops/kernel": "0.10.0-next.5",
    "@apexops/renderers": "0.10.0-next.5",
    "@azure/mcp": "3.0.0-beta.37",
    "@hono/node-server": "2.1.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@sinclair/typebox": "0.34.52",
    "hono": "4.12.34",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "js-yaml": "5.2.2"
  },
  "scripts": {
    "build": "tsc -b",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "prepack": "npm run build && npm run prepare:assets",
    "test": "node --test dist/test/*.test.js"
  },
  "engines": {
    "node": ">=24"
  }
}
