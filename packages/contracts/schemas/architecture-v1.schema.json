{
  "$id": "https://schemas.apexops.dev/architecture-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "components": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "dependsOn": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "purpose": {
            "minLength": 1,
            "type": "string"
          },
          "requirementIds": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "service": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "service",
          "purpose",
          "requirementIds",
          "dependsOn"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "decisions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "projectId": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "risks": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "runId": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "sourceHashes": {
      "patternProperties": {
        "^(.*)$": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "summary": {
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "wellArchitectedAssessment": {
      "additionalProperties": false,
      "properties": {
        "assessmentType": {
          "const": "qualitative",
          "type": "string"
        },
        "framework": {
          "const": "azure-well-architected-framework",
          "type": "string"
        },
        "pillars": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "assessment": {
                "minLength": 1,
                "type": "string"
              },
              "evidenceRefs": {
                "items": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "pillar": {
                "anyOf": [
                  {
                    "const": "security",
                    "type": "string"
                  },
                  {
                    "const": "reliability",
                    "type": "string"
                  },
                  {
                    "const": "performance-efficiency",
                    "type": "string"
                  },
                  {
                    "const": "cost-optimization",
                    "type": "string"
                  },
                  {
                    "const": "operational-excellence",
                    "type": "string"
                  }
                ]
              },
              "recommendations": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "requirementIds": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "status": {
                "anyOf": [
                  {
                    "const": "aligned",
                    "type": "string"
                  },
                  {
                    "const": "concern",
                    "type": "string"
                  },
                  {
                    "const": "blocker",
                    "type": "string"
                  },
                  {
                    "const": "not-applicable",
                    "type": "string"
                  }
                ]
              },
              "tradeoffs": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              }
            },
            "required": [
              "pillar",
              "status",
              "assessment",
              "requirementIds",
              "evidenceRefs",
              "recommendations",
              "tradeoffs"
            ],
            "type": "object"
          },
          "maxItems": 5,
          "minItems": 5,
          "type": "array"
        }
      },
      "required": [
        "framework",
        "assessmentType",
        "pillars"
      ],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "projectId",
    "runId",
    "title",
    "summary",
    "sourceHashes",
    "components",
    "decisions",
    "risks"
  ],
  "type": "object"
}
