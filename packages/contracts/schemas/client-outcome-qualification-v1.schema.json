{
  "$id": "https://schemas.apexops.dev/client-outcome-qualification-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "binding": {
      "additionalProperties": false,
      "properties": {
        "candidateId": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "clients": {
          "additionalProperties": false,
          "properties": {
            "cliVersion": {
              "maxLength": 32,
              "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}(?:-[0-9A-Za-z.-]+)?$",
              "type": "string"
            },
            "vscodeExtensionVersion": {
              "maxLength": 32,
              "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}(?:-[0-9A-Za-z.-]+)?$",
              "type": "string"
            },
            "vscodeVersion": {
              "maxLength": 32,
              "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}(?:-[0-9A-Za-z.-]+)?$",
              "type": "string"
            }
          },
          "required": [
            "vscodeVersion",
            "vscodeExtensionVersion",
            "cliVersion"
          ],
          "type": "object"
        },
        "toolchainHash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "candidateId",
        "toolchainHash",
        "clients"
      ],
      "type": "object"
    },
    "comparisons": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "comparisonId": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "outcomeIds": {
            "additionalProperties": false,
            "properties": {
              "cli": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "vscode": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "vscode",
              "cli"
            ],
            "type": "object"
          },
          "scenarioId": {
            "anyOf": [
              {
                "const": "CLIENT-001",
                "type": "string"
              },
              {
                "const": "CLIENT-002",
                "type": "string"
              },
              {
                "const": "CLIENT-003",
                "type": "string"
              },
              {
                "const": "CLIENT-004",
                "type": "string"
              },
              {
                "const": "CLIENT-005",
                "type": "string"
              },
              {
                "const": "CLIENT-006",
                "type": "string"
              },
              {
                "const": "CLIENT-007",
                "type": "string"
              },
              {
                "const": "CLIENT-008",
                "type": "string"
              },
              {
                "const": "CLIENT-009",
                "type": "string"
              },
              {
                "const": "CLIENT-010",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "scenarioId",
          "comparisonId",
          "outcomeIds"
        ],
        "type": "object"
      },
      "maxItems": 10,
      "minItems": 10,
      "type": "array"
    },
    "evidenceKind": {
      "anyOf": [
        {
          "const": "fixture",
          "type": "string"
        },
        {
          "const": "live",
          "type": "string"
        }
      ]
    },
    "matrixComplete": {
      "const": true,
      "type": "boolean"
    },
    "qualificationId": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "qualifiesClientParity": {
      "const": true,
      "type": "boolean"
    },
    "qualifiesRelease": {
      "const": false,
      "type": "boolean"
    },
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "status": {
      "const": "pass",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "evidenceKind",
    "binding",
    "comparisons",
    "status",
    "matrixComplete",
    "qualifiesClientParity",
    "qualifiesRelease",
    "qualificationId"
  ],
  "type": "object"
}
