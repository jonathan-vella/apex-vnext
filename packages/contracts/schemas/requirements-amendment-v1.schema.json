{
  "$id": "https://schemas.apexops.dev/requirements-amendment-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "additions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "priority": {
            "anyOf": [
              {
                "const": "must",
                "type": "string"
              },
              {
                "const": "should",
                "type": "string"
              },
              {
                "const": "could",
                "type": "string"
              }
            ]
          },
          "source": {
            "minLength": 1,
            "type": "string"
          },
          "statement": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "const": "confirmed",
                "type": "string"
              },
              {
                "const": "unknown",
                "type": "string"
              },
              {
                "const": "deferred",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "id",
          "statement",
          "priority",
          "status",
          "source"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "type": "array"
    },
    "baseRequirementsHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "fields": {
      "additionalProperties": false,
      "properties": {
        "architectureHandoff": {
          "minLength": 1,
          "type": "string"
        },
        "assumptions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "budgetAndOperations": {
          "minLength": 1,
          "type": "string"
        },
        "businessContext": {
          "minLength": 1,
          "type": "string"
        },
        "nonFunctionalRequirements": {
          "minLength": 1,
          "type": "string"
        },
        "regionalConstraints": {
          "minLength": 1,
          "type": "string"
        },
        "securityAndCompliance": {
          "minLength": 1,
          "type": "string"
        },
        "successCriteria": {
          "minLength": 1,
          "type": "string"
        },
        "unknowns": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "workload": {
          "minLength": 1,
          "type": "string"
        }
      },
      "type": "object"
    },
    "removals": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 128,
      "type": "array",
      "uniqueItems": true
    },
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "updates": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "changes": {
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "priority": {
                "anyOf": [
                  {
                    "const": "must",
                    "type": "string"
                  },
                  {
                    "const": "should",
                    "type": "string"
                  },
                  {
                    "const": "could",
                    "type": "string"
                  }
                ]
              },
              "source": {
                "minLength": 1,
                "type": "string"
              },
              "statement": {
                "minLength": 1,
                "type": "string"
              },
              "status": {
                "anyOf": [
                  {
                    "const": "confirmed",
                    "type": "string"
                  },
                  {
                    "const": "unknown",
                    "type": "string"
                  },
                  {
                    "const": "deferred",
                    "type": "string"
                  }
                ]
              }
            },
            "type": "object"
          },
          "id": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "changes"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "baseRequirementsHash",
    "updates",
    "additions",
    "removals",
    "fields"
  ],
  "type": "object"
}
