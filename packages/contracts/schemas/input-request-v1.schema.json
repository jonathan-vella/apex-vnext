{
  "$id": "https://schemas.apexops.dev/input-request-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expectedHead": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ownerEpoch": {
      "minimum": 1,
      "type": "integer"
    },
    "questions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "multiSelect": {
            "type": "boolean"
          },
          "options": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "prompt": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "prompt"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "requestId": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "expectedHead",
    "ownerEpoch",
    "questions"
  ],
  "type": "object"
}
