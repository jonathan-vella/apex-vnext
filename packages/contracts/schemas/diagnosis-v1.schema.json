{
  "$id": "https://schemas.apexops.dev/diagnosis-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "causes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "anyOf": [
              {
                "const": "low",
                "type": "string"
              },
              {
                "const": "medium",
                "type": "string"
              },
              {
                "const": "high",
                "type": "string"
              }
            ]
          },
          "evidenceRefs": {
            "items": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "remediation": {
            "minLength": 1,
            "type": "string"
          },
          "summary": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "summary",
          "confidence",
          "evidenceRefs"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "diagnosedAt": {
      "format": "date-time",
      "type": "string"
    },
    "observations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "operationalHandoff": {
      "additionalProperties": false,
      "properties": {
        "accessPrerequisites": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        },
        "configurationReferences": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "minLength": 1,
                "type": "string"
              },
              "source": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "name",
              "source"
            ],
            "type": "object"
          },
          "maxItems": 128,
          "type": "array"
        },
        "escalation": {
          "minLength": 1,
          "type": "string"
        },
        "healthChecks": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "check": {
                "minLength": 1,
                "type": "string"
              },
              "evidenceRefs": {
                "items": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "maxItems": 32,
                "type": "array",
                "uniqueItems": true
              },
              "expectedOutcome": {
                "minLength": 1,
                "type": "string"
              },
              "resourceId": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "resourceId",
              "check",
              "expectedOutcome",
              "evidenceRefs"
            ],
            "type": "object"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        },
        "incidentResponse": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "applicability": {
                  "const": "applicable",
                  "type": "string"
                },
                "executionStatus": {
                  "const": "untested",
                  "type": "string"
                },
                "owner": {
                  "minLength": 1,
                  "type": "string"
                },
                "prerequisites": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "maxItems": 32,
                  "minItems": 1,
                  "type": "array"
                },
                "steps": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "maxItems": 64,
                  "minItems": 1,
                  "type": "array"
                },
                "verification": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "applicability",
                "owner",
                "prerequisites",
                "steps",
                "verification",
                "executionStatus"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "applicability": {
                  "const": "not-applicable",
                  "type": "string"
                },
                "rationale": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "applicability",
                "rationale"
              ],
              "type": "object"
            }
          ]
        },
        "limitations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "maintenanceWindow": {
          "minLength": 1,
          "type": "string"
        },
        "monitoring": {
          "minLength": 1,
          "type": "string"
        },
        "owner": {
          "minLength": 1,
          "type": "string"
        },
        "recovery": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "applicability": {
                  "const": "applicable",
                  "type": "string"
                },
                "executionStatus": {
                  "const": "untested",
                  "type": "string"
                },
                "owner": {
                  "minLength": 1,
                  "type": "string"
                },
                "prerequisites": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "maxItems": 32,
                  "minItems": 1,
                  "type": "array"
                },
                "steps": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "maxItems": 64,
                  "minItems": 1,
                  "type": "array"
                },
                "verification": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "applicability",
                "owner",
                "prerequisites",
                "steps",
                "verification",
                "executionStatus"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "applicability": {
                  "const": "not-applicable",
                  "type": "string"
                },
                "rationale": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "applicability",
                "rationale"
              ],
              "type": "object"
            }
          ]
        },
        "rollback": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "applicability": {
                  "const": "applicable",
                  "type": "string"
                },
                "executionStatus": {
                  "const": "untested",
                  "type": "string"
                },
                "owner": {
                  "minLength": 1,
                  "type": "string"
                },
                "prerequisites": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "maxItems": 32,
                  "minItems": 1,
                  "type": "array"
                },
                "steps": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "maxItems": 64,
                  "minItems": 1,
                  "type": "array"
                },
                "verification": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "applicability",
                "owner",
                "prerequisites",
                "steps",
                "verification",
                "executionStatus"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "applicability": {
                  "const": "not-applicable",
                  "type": "string"
                },
                "rationale": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "applicability",
                "rationale"
              ],
              "type": "object"
            }
          ]
        }
      },
      "required": [
        "owner",
        "escalation",
        "maintenanceWindow",
        "accessPrerequisites",
        "configurationReferences",
        "healthChecks",
        "monitoring",
        "incidentResponse",
        "rollback",
        "recovery",
        "limitations"
      ],
      "type": "object"
    },
    "projectId": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "runId": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "const": "healthy",
          "type": "string"
        },
        {
          "const": "degraded",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "unknown",
          "type": "string"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "projectId",
    "runId",
    "diagnosedAt",
    "status",
    "observations",
    "causes"
  ],
  "type": "object"
}
