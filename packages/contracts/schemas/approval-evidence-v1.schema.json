        },
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "gate": {
          "const": 1,
          "type": "number"
        },
        "mechanism": {
          "const": "lab-delegation",
          "type": "string"
        },
        "policyHash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "previewHash": {
          "not": {}
        },
        "projectId": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        "recipientIdentity": {
          "minLength": 1,
          "type": "string"
        },
        "runId": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$",
          "type": "string"
        },
        "schemaVersion": {
          "const": "1.0.0",
          "type": "string"
        },
        "scopeEvidenceHash": {
          "not": {}
        },
        "writerEpoch": {
          "minimum": 1,
          "type": "integer"
        },
        "writerTransferClaimHash": {
          "not": {}
        }
      },
