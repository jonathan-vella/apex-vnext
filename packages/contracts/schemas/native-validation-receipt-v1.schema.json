{
  "$id": "https://schemas.apexops.dev/native-validation-receipt-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "commands": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "commandHash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "exitCode": {
            "const": 0,
            "type": "number"
          },
          "outputTruncated": {
            "const": false,
            "type": "boolean"
          },
          "signal": {
            "type": "null"
          },
          "timedOut": {
            "const": false,
            "type": "boolean"
          },
          "validatorId": {
            "anyOf": [
              {
                "const": "bicep:format",
                "type": "string"
              },
              {
                "const": "bicep:build",
                "type": "string"
              },
              {
                "const": "bicep:lint",
                "type": "string"
              },
              {
                "const": "terraform:init-backend-false",
                "type": "string"
              },
              {
                "const": "terraform:format",
                "type": "string"
              },
              {
                "const": "terraform:validate",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "validatorId",
          "commandHash",
          "exitCode",
          "signal",
          "timedOut",
          "outputTruncated"
        ],
        "type": "object"
      },
      "maxItems": 3,
      "minItems": 1,
      "type": "array"
    },
    "inputHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "outcome": {
      "const": "pass",
      "type": "string"
    },
    "policyHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "projectId": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "receiptHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "runId": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "sourceHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "track": {
      "anyOf": [
        {
          "const": "bicep",
          "type": "string"
        },
        {
          "const": "terraform",
          "type": "string"
        }
      ]
    },
    "treeHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "projectId",
    "runId",
    "track",
    "sourceHash",
    "treeHash",
    "policyHash",
    "inputHash",
    "outcome",
    "commands",
    "receiptHash"
  ],
  "type": "object"
}
