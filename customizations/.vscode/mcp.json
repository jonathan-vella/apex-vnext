{
  "servers": {
    "apex": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${workspaceFolder}/node_modules/@apexops/cli/dist/cli.js",
        "mcp",
        "serve"
      ],
      "cwd": "${workspaceFolder}"
    },
    "azure-resource-manager-mcp": {
      "type": "http",
      "url": "https://mcp.management.azure.com",
      "headers": {
        "x-mcp-toolset": "CostManagement,Pricing"
      }
    },
    "azure-mcp-server": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "@azure/mcp",
        "server",
        "start"
      ],
      "cwd": "${workspaceFolder}"
    }
  }
}
