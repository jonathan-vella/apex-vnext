{
  "schemaVersion": "1.0.0",
  "outputDirectory": "dist/apex-plugin",
  "plugin": {
    "source": "plugin/plugin.json",
    "target": "plugin.json",
    "versionFrom": "packages/cli/package.json"
  },
  "mcp": {
    "source": "plugin/mcp.json",
    "target": "mcp.json",
    "server": "apex"
  },
  "server": {
    "entry": "plugin/mcp/apex.mjs",
    "target": "mcp/apex.mjs",
    "nodeTarget": "node24"
  },
  "agents": {
    "sourceRoot": "customizations/.github/agents",
    "targetRoot": "com.github.copilot/agents"
  },
  "skills": {
    "sourceRoot": "customizations/.github/skills",
    "targetRoot": "skills"
  },
  "hooks": {
    "sourceRoot": "plugin/hooks",
    "targetRoot": "com.github.copilot/hooks",
    "entries": ["apex-hook.mjs", "hooks.json"]
  },
  "assets": {
    "sourceRoot": "packages/cli/assets",
    "targetRoot": "assets"
  },
  "native": {
    "package": "@resvg/resvg-js",
    "targetRoot": "native/resvg-js",
    "source": "https://github.com/yisibl/resvg-js",
    "binaries": {
      "linux-x64": {
        "package": "@resvg/resvg-js-linux-x64-gnu",
        "file": "resvgjs.linux-x64-gnu.node",
        "libc": "glibc"
      },
      "win32-x64": {
        "package": "@resvg/resvg-js-win32-x64-msvc",
        "file": "resvgjs.win32-x64-msvc.node"
      }
    }
  }
}
